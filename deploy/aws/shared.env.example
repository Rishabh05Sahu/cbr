# Copy to /opt/crm/shared.env ON THE SERVER ONLY (chmod 600). Never commit real values.
# Read by web and worker. Role URLs: Supabase session pooler (IPv4, port 5432), user <role>.<ref>.
NODE_ENV=production
DATABASE_URL=postgresql://crm_app.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/run/crm/supabase-ca.crt
AUTH_DATABASE_URL=postgresql://crm_auth.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/run/crm/supabase-ca.crt
PLATFORM_DATABASE_URL=postgresql://crm_platform.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/run/crm/supabase-ca.crt
# Supabase Nano allows 60 connections; 4 keeps web + worker at about 17 (supabase-free-setup.md §5).
DATABASE_POOL_MAX=4
REDIS_URL=redis://valkey:6379
# Free start: Gmail SMTP (runbook §6.4). Later: email-smtp.ap-south-1.amazonaws.com (SES).
# Credentials are in worker.env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=CBR Property CRM <<the CRM gmail address>>
BETTER_AUTH_URL=https://<your-domain>
# Generate on your machine: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
LOG_LEVEL=info
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMPORT_BUCKET=crm-imports

# Copy to /opt/crm/worker.env ON THE SERVER ONLY (chmod 600). Worker-only secrets.
# Free start: the CRM Gmail address and its 16-letter app password (runbook §6.4).
# Later: SES SMTP credentials from the restricted sender IAM user (email-ses-setup.md §3).
SMTP_USER=
SMTP_PASSWORD=
# Import/export file cleanup sweep (crm_cleanup). Without it the sweep does not run.
CLEANUP_DATABASE_URL=postgresql://crm_cleanup.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=/run/crm/supabase-ca.crt

{
  "name": "cbr-property-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "db:up": "docker compose up -d --wait postgres valkey mailpit",
    "db:down": "docker compose down",
    "spike:s1:generate": "prisma generate --config spikes/s1-tenant-isolation/prisma.config.ts",
    "spike:s1:migrate": "prisma migrate deploy --config spikes/s1-tenant-isolation/prisma.config.ts",
    "spike:s1:test": "vitest run --project s1",
    "spike:s2:generate": "prisma generate --config spikes/s2-identity/prisma.config.ts",
    "spike:s2:migrate": "prisma migrate deploy --config spikes/s2-identity/prisma.config.ts",
    "spike:s2:test": "vitest run --project s2",
    "build:worker": "esbuild src/worker/main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/worker.mjs --sourcemap",
    "worker": "node --enable-source-maps dist/worker.mjs",
    "worker:dev": "tsx watch src/worker/main.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:security": "vitest run --project integration tests/integration/db-roles.test.ts tests/integration/cross-org-isolation.test.ts && vitest run --project e2e tests/e2e/route-isolation.test.ts",
    "postinstall": "prisma generate",
    "spike:s1:managed": "vitest run --project s1 spikes/s1-tenant-isolation/tests/s1-01-02-catalog.test.ts spikes/s1-tenant-isolation/tests/s1-03-07-isolation.test.ts spikes/s1-tenant-isolation/tests/s1-08-concurrency.test.ts",
    "drill:logical": "node scripts/recovery/logical-restore-drill.mjs",
    "drill:pitr": "node scripts/recovery/pitr-drill.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "better-auth": "1.7.11",
    "bullmq": "6.3.12",
    "csv-parse": "7.0.3",
    "ioredis": "5.11.1",
    "next": "16.4.2",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}

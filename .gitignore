# dependencies
node_modules/
.pnpm-store/

# next.js / build
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# generated prisma clients
**/generated/

# env files (only .env.example is committed)
.env
.env.*
!.env.example

# keys, certificates and credential files (e.g. a managed database's CA download)
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/

# test / coverage / reports
coverage/
spikes/**/results/*.json

# misc
.DS_Store
*.log
npm-debug.log*
pnpm-debug.log*

# bundled worker
dist/

# keep test evidence logs (synthetic data only)
!spikes/results/*.log
# local rehearsals of the managed-database run (not evidence)
spikes/results/managed-rehearsal/
# managed-database run checkpoints (reviewed evidence is copied to docs/architecture/spikes/results)
spikes/results/managed-runs/
!docs/architecture/spikes/results/*.log
.neon

/.env.s1-managed

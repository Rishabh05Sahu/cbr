# Copy to .env for local development. Values here are local-only placeholders.
# Never reuse these passwords outside your machine.

# Docker Compose (docker/postgres/init/01-roles.sh)
POSTGRES_SUPERUSER_PASSWORD=local-superuser-pw
CRM_MIGRATOR_PASSWORD=local-migrator-pw
CRM_APP_PASSWORD=local-app-pw
CRM_PLATFORM_PASSWORD=local-platform-pw
CRM_AUTH_PASSWORD=local-auth-pw
# Import-file cleanup role (scripts/db/provision-cleanup-role.sql; needed before migration 0005)
CRM_CLEANUP_PASSWORD=local-cleanup-pw

# Application (runtime role crm_app; never the owner or an admin user)
DATABASE_URL=postgresql://crm_app:local-app-pw@127.0.0.1:55432/crm_dev
# Better Auth only (role crm_auth, D2)
AUTH_DATABASE_URL=postgresql://crm_auth:local-auth-pw@127.0.0.1:55432/crm_dev
# Platform console (role crm_platform)
PLATFORM_DATABASE_URL=postgresql://crm_platform:local-platform-pw@127.0.0.1:55432/crm_dev
# Import-file cleanup sweep (role crm_cleanup). Only the worker connects with it; omit it from
# the web deployment's environment.
CLEANUP_DATABASE_URL=postgresql://crm_cleanup:local-cleanup-pw@127.0.0.1:55432/crm_dev
# Migrations only (role crm_migrator)
DATABASE_MIGRATOR_URL=postgresql://crm_migrator:local-migrator-pw@127.0.0.1:55432/crm_dev
REDIS_URL=redis://127.0.0.1:56379
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
# Mailpit web UI: http://127.0.0.1:54025 (58025 is inside a Windows reserved port range)
BETTER_AUTH_URL=http://localhost:3000
EMAIL_FROM=CBR Property CRM <no-reply@cbr-crm.local>
LOG_LEVEL=info

# Phase 2 M4 lead imports: Supabase Storage, PRIVATE bucket (docs/runbooks/supabase-storage-setup.md).
# Leave the URL and key empty to run without imports. The key is a server-only secret: never
# give it a NEXT_PUBLIC_ prefix, never commit a real value, never paste it into chat or tickets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMPORT_BUCKET=crm-imports
# Bytes; 20 MB default, must not exceed 52428800 (Supabase Free 50 MB object limit).
IMPORT_MAX_BYTES=20971520
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes

# Connections per process: crm_app pool = DATABASE_POOL_MAX, crm_auth = max(2, half of it),
# crm_platform = 2, worker also crm_cleanup = 1. Default 10 (local). On Supabase Free use 4
# (docs/runbooks/supabase-free-setup.md §5): web ≈ 8 and worker ≈ 9 session connections.
# DATABASE_POOL_MAX=4
# Worker only: import commit strategy. Default 'set' (set-based); 'row' is the ROLLBACK
# (one row at a time, same outcomes). Any other value stops the worker at start.
# IMPORT_COMMIT_STRATEGY=row

# ---------------------------------------------------------------------------------------------
# Supabase Free pilot (docs/runbooks/supabase-free-setup.md). Placeholders only: real values go
# in your local .env or the host's secret store, never in this file, Git, chat or tickets.
# Use the SHARED POOLER, SESSION MODE (port 5432, IPv4) from the dashboard's Connect panel; the
# pooler needs the user name in the form <role>.<project-ref>. Percent-encode special
# characters in passwords. The `postgres` admin login is needed only for the one-time bootstrap
# (scripts/db/bootstrap-supabase.mjs, runbook §4) and is not part of any app environment.
# DATABASE_URL=postgresql://crm_app.<project-ref>:<password>@<pooler-host>:5432/postgres
# AUTH_DATABASE_URL=postgresql://crm_auth.<project-ref>:<password>@<pooler-host>:5432/postgres
# PLATFORM_DATABASE_URL=postgresql://crm_platform.<project-ref>:<password>@<pooler-host>:5432/postgres
# CLEANUP_DATABASE_URL=postgresql://crm_cleanup.<project-ref>:<password>@<pooler-host>:5432/postgres
# DATABASE_MIGRATOR_URL=postgresql://crm_migrator.<project-ref>:<password>@<pooler-host>:5432/postgres
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<secret key from the dashboard; server only>
# ---------------------------------------------------------------------------------------------

# ---------------------------------------------------------------------------------------------
# Supabase ACCEPTANCE project (disposable, synthetic data only; runbook §4). Lives in the same
# .env as the local settings; the ACCEPTANCE_ prefix keeps it apart, and the acceptance scripts
# (scripts/db/supabase-acceptance-preflight.mjs, bootstrap-supabase.mjs) read only these names.
# Role URLs: postgresql://crm_<role>.<project-ref>:<that role's password>@<pooler-host>:5432/postgres
# Role passwords: five new, independent values of 24+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ACCEPTANCE_PGUSER is postgres.<project-ref>; ACCEPTANCE_PGPASSWORD is the database password.
ACCEPTANCE_PROJECT_REF=
# Only if ACCEPTANCE_PROJECT_REF is deliberately the project in SUPABASE_URL: exactly "true".
# Absent or anything else, that project is refused.
# ACCEPTANCE_ALLOW_EXISTING_PROJECT=true
ACCEPTANCE_DATABASE_MIGRATOR_URL=
ACCEPTANCE_DATABASE_URL=
ACCEPTANCE_AUTH_DATABASE_URL=
ACCEPTANCE_PLATFORM_DATABASE_URL=
ACCEPTANCE_CLEANUP_DATABASE_URL=
ACCEPTANCE_CRM_MIGRATOR_PASSWORD=
ACCEPTANCE_CRM_APP_PASSWORD=
ACCEPTANCE_CRM_AUTH_PASSWORD=
ACCEPTANCE_CRM_PLATFORM_PASSWORD=
ACCEPTANCE_CRM_CLEANUP_PASSWORD=
ACCEPTANCE_PGHOST=
ACCEPTANCE_PGPORT=5432
ACCEPTANCE_PGDATABASE=postgres
ACCEPTANCE_PGUSER=
ACCEPTANCE_PGPASSWORD=
ACCEPTANCE_PGSSLMODE=verify-full
# Absolute path to the project's root CA (Database Settings > SSL Configuration > Download
# certificate), saved outside the repository. Required: there is no unverified mode.
ACCEPTANCE_PGSSLROOTCERT=
# ---------------------------------------------------------------------------------------------

# Spikes (Phase 1 gate) — separate throwaway databases
S1_APP_URL=postgresql://crm_app:local-app-pw@127.0.0.1:55432/crm_s1
S1_MIGRATOR_URL=postgresql://crm_migrator:local-migrator-pw@127.0.0.1:55432/crm_s1
S1_PLATFORM_URL=postgresql://crm_platform:local-platform-pw@127.0.0.1:55432/crm_s1
S2_APP_URL=postgresql://crm_app:local-app-pw@127.0.0.1:55432/crm_s2
S2_MIGRATOR_URL=postgresql://crm_migrator:local-migrator-pw@127.0.0.1:55432/crm_s2
S2_AUTH_URL=postgresql://crm_auth:local-auth-pw@127.0.0.1:55432/crm_s2
S2_PLATFORM_URL=postgresql://crm_platform:local-platform-pw@127.0.0.1:55432/crm_s2

# Integration / e2e tests (separate database crm_test)
TEST_DATABASE_URL=postgresql://crm_app:local-app-pw@127.0.0.1:55432/crm_test
TEST_AUTH_DATABASE_URL=postgresql://crm_auth:local-auth-pw@127.0.0.1:55432/crm_test
TEST_PLATFORM_DATABASE_URL=postgresql://crm_platform:local-platform-pw@127.0.0.1:55432/crm_test
TEST_CLEANUP_DATABASE_URL=postgresql://crm_cleanup:local-cleanup-pw@127.0.0.1:55432/crm_test
TEST_MIGRATOR_URL=postgresql://crm_migrator:local-migrator-pw@127.0.0.1:55432/crm_test
